# Listen address
PORT=8787
HOST=127.0.0.1

# Default browser: a port, an http(s) origin, or a ws(s) CDP URL.
# Start one with `pnpm chrome`, or use any Chrome launched with
#   --remote-debugging-port=9222 --remote-allow-origins='*'
# Callers may override it per request with `cdpUrl`.
BROWSE_CDP_URL=9222

# Sandbox limits
SANDBOX_TIMEOUT_MS=120000
SANDBOX_MAX_COMMANDS=256

# Lock down the surface. `upload` reads server-side files; `eval` runs page JS.
# BROWSE_DENY_COMMANDS=browse.upload,browse.eval

# Require `Authorization: Bearer <token>`. Strongly recommended: without it,
# anything that can reach this port can drive the browser and its logged-in sessions.
# MCP_AUTH_TOKEN=change-me
